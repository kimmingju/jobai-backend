// 각 애플리케이션 호스트에서 Docker 컨테이너 로그를 수집해 Loki로 보낸다.
// Promtail은 지원이 종료되어 후속인 Grafana Alloy를 쓴다.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// 컨테이너 이름을 라벨로 남긴다. 앞의 슬래시를 떼어낸다.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.app.receiver]

  labels = {
    host = sys.env("HOST_LABEL"),
  }
}

// 스택트레이스가 줄 단위로 쪼개지면 원인 추적이 어렵다.
// 타임스탬프로 시작하지 않는 줄은 앞줄에 이어 붙인다.
loki.process "app" {
  forward_to = [loki.write.default.receiver]

  stage.multiline {
    firstline     = "^[0-9]{4}-[0-9]{2}-[0-9]{2}[ T][0-9]{2}:[0-9]{2}:[0-9]{2}"
    max_lines     = 200
    max_wait_time = "3s"
  }

  stage.regex {
    expression = "(?P<level>ERROR|WARN|INFO|DEBUG|TRACE)"
  }

  stage.labels {
    values = { level = "" }
  }
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL")
  }
}
